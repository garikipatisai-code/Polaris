{
  "name": "polaris-extension",
  "private": true,
  "version": "0.0.1",
  "description": "Goal-anchored agentic browser extension powered by a local Qwen3.5-4B via Ollama.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:watch": "vitest --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:integration:full": "POLARIS_REAL_OLLAMA=1 vitest run tests/integration.test.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "typescript": "^5.6.3",
    "undici": "^8.3.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  }
}
